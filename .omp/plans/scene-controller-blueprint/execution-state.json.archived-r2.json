  "requirements": [
    {
      "id": "R1",
      "summary": "Blueprint metadata and ten button inputs (entity + action per button 1-5)"
    },
    {
      "id": "R2",
      "summary": "Event-only entity selectors and optional action selectors defaulting to empty"
    },
    {
      "id": "R3",
      "summary": "Imports into Home Assistant without error (owner-verified live, U1)"
    },
    {
      "id": "R4",
      "summary": "Pushed event on button N runs button N action; empty action is a no-op"
    },
    {
      "id": "R5",
      "summary": "Held, doubleTapped, released events run nothing"
    },
    {
      "id": "R6",
      "summary": "One-command python3+PyYAML repo-local validation documented in README"
    },
    {
      "id": "R7",
      "summary": "Header comment documents four event types and MQTT/Hubitat origin"
    },
    {
      "id": "R8",
      "summary": "Generic by design: no vendor, model, node id, room name, concrete entity id"
    },
    {
      "id": "R9",
      "summary": "Scope fence: no ticket 02-09 features; mode: parallel is ticket 02; immutable ticket-01 input map"
    }
  ],
